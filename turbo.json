{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"],
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL", "HOST", "PORT", "LOG_LEVEL"]
    },
    "test:api": {
      "dependsOn": ["@mindbridge/api#build"],
      "cache": false,
      "passThroughEnv": ["API_URL", "DATABASE_URL", "CI", "MINDBRIDGE_API_KEY"]
    }
  }
}
