{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"],
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "MINDBRIDGE_API_URL",
        "WEB_PORT"
      ]
    },
    "test:api": {
      "dependsOn": ["@mindbridge/api#build", "@mindbridge/mcp#build"],
      "cache": false,
      "passThroughEnv": ["API_URL", "DATABASE_URL", "CI", "MINDBRIDGE_API_KEY"]
    },
    "test:e2e": {
      "dependsOn": ["@mindbridge/api#build", "@mindbridge/web#build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "CI", "E2E_*"]
    },
    "test:visual": {
      "dependsOn": ["@mindbridge/api#build", "@mindbridge/web#build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "CI", "E2E_*", "PW_*"]
    },
    "test:mutation": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["reports/mutation/**"]
    }
  }
}
