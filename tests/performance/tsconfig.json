{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // k6 loads modules by exact path, so imports keep their .ts extension.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["k6"]
  },
  "include": ["**/*.ts"]
}
