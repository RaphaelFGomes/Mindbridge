{
  "name": "@mindbridge/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Browser end-to-end tests for the web UI: user flows, accessibility (axe-core), no-JavaScript fallbacks.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test --project=signed-out --project=chromium --project=no-javascript",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report reports/playwright"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "1.65.1"
  }
}
