{
  "name": "@mindbridge/mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Mindbridge MCP server (stdio): lets Claude Code, Copilot, Cursor and friends read and write shared memories through the Mindbridge API.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mindbridge-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:api": "openapi-typescript ../api/openapi.json --output src/generated/api.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.1",
    "openapi-typescript": "^7.13.0",
    "vitest": "5.1.1"
  }
}
