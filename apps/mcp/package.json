{
  "name": "@mindbridge/mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Mindbridge MCP server (stdio): lets Claude Code, Copilot, Cursor and friends read and write shared memories through the Mindbridge API.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mindbridge-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@mindbridge/api-client": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "vitest": "5.1.1"
  }
}
