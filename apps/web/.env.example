# Copy to .env.local (git-ignored) and adjust.

# Where the Mindbridge API runs.
MINDBRIDGE_API_URL=http://127.0.0.1:4000

# Optional, for local use: sign in automatically with this key (skips the login page).
# The server only listens on 127.0.0.1; never set this on a server others can reach.
# MINDBRIDGE_API_KEY=mb_...

# The dev/start port comes from WEB_PORT in your shell (default 3000), e.g. WEB_PORT=3001 pnpm dev
