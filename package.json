{
  "name": "mindbridge",
  "version": "0.0.0",
  "private": true,
  "description": "Vendor-agnostic shared memory for AI assistants.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:coverage": "turbo run test:coverage",
    "test:api": "turbo run test:api",
    "test:e2e": "turbo run test:e2e",
    "test:visual": "turbo run test:visual",
    "visual:browser": "tests/e2e/scripts/visual-browser.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @mindbridge/api db:migrate",
    "keys:create": "pnpm --silent --filter @mindbridge/api keys create",
    "keys:list": "pnpm --silent --filter @mindbridge/api keys list",
    "keys:revoke": "pnpm --silent --filter @mindbridge/api keys revoke"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
